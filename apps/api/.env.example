# Copia este archivo como .env (nunca subas .env al repositorio).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL levantado con `npm run db:up` (docker-compose.yml)
DATABASE_URL=postgresql://simplify:simplify_dev@localhost:5434/simplify

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:5173

# Clave para firmar las sesiones (JWT). Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
