// Modelo de datos de Simplify. Diagrama y explicación: docs/modelo-datos.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INCOME
  EXPENSE
}

enum Currency {
  USD
  PEN
  EUR
  MXN
  COP
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(60)
  passwordHash String   @map("password_hash")
  currency     Currency @default(USD)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories    Category[]
  movements     Movement[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String       @db.VarChar(40)
  type      MovementType
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements Movement[]

  // Un usuario no puede repetir el nombre de una categoría dentro del mismo tipo.
  @@unique([userId, type, name])
  // Permite exigir en la base de datos que el movimiento use una categoría del mismo usuario (RN-05)
  // y del mismo tipo (RN-03).
  @@unique([id, userId, type])
  @@index([userId, type])
  @@map("categories")
}

model Movement {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  categoryId  String       @map("category_id") @db.Uuid
  type        MovementType
  description String       @db.VarChar(120)
  // RN-01 y 5.3: dinero con precisión decimal, nunca punto flotante.
  amount      Decimal      @db.Decimal(12, 2)
  // RN-08: fecha de calendario, sin hora, para que los límites del mes no dependan de la zona horaria.
  date        DateTime     @db.Date
  notes       String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // RN-09: Restrict impide borrar una categoría con movimientos.
  // La relación compuesta (categoryId, userId, type) garantiza que la categoría sea del mismo
  // usuario (RN-05) y del mismo tipo (RN-03) que el movimiento.
  category Category @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, type, date])
  @@map("movements")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Solo se guarda el hash del token, nunca el token en claro.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Intentos de inicio de sesión. Vive en PostgreSQL (no en memoria) para que el límite
// funcione igual con varias instancias de la API detrás del balanceador. Ver docs/adr/0004.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  // Hash del correo + IP, para no guardar datos personales en claro.
  key       String   @db.VarChar(128)
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([key, createdAt])
  @@map("login_attempts")
}
