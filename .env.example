# Variables para el modo producción con Docker (docker-compose.prod.yml).
# Copia este archivo como .env (nunca se sube a git) y completa los valores.
# Genera cada clave con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Contraseña de PostgreSQL. Solo letras y números: va dentro de una URL de conexión.
POSTGRES_PASSWORD=

# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres, distinta de la de desarrollo.
JWT_SECRET=
